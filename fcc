#!/usr/bin/env python3

from __future__ import annotations

from argparse import Namespace, ArgumentParser
import argparse
import os
import subprocess
import sys
from dataclasses import dataclass
from enum import IntEnum
from pathlib import Path
from tempfile import TemporaryDirectory


class Stage(IntEnum):
    PREPROCESS = 0
    COMPILE = 1
    LOWER = 2
    ASSEMBLE = 3
    LINK = 4


PIPELINE = [Stage.PREPROCESS, Stage.COMPILE, Stage.LOWER, Stage.ASSEMBLE]

OUT_EXTENTION = {
    Stage.PREPROCESS: "i",
    Stage.COMPILE: "ll",
    Stage.LOWER: "s",
    Stage.ASSEMBLE: "o",
    Stage.LINK: "out",
}

IN_EXTENTION = {
    "c": Stage.PREPROCESS,
    "i": Stage.COMPILE,
    "ll": Stage.LOWER,
    "s": Stage.ASSEMBLE,
    "o": Stage.LINK,
    "a": Stage.LINK,
    "so": Stage.LINK,
}

TOOL = {
    Stage.PREPROCESS: "clang",
    Stage.COMPILE: "cc1",
    Stage.LOWER: "llc",
    Stage.ASSEMBLE: "as",
    Stage.LINK: "clang",
}


@dataclass
class Step:
    stage: Stage
    input: str
    output: str


@dataclass
class LinkItem:
    value: str
    is_input: bool


def preprocess_argv(step: Step, args: Namespace) -> list[str]:
    argv = ["clang", "-E", "-std=c89", "-m32"]
    argv.extend(f"-D{name}" for name in args.defines)
    argv.extend(f"-U{name}" for name in args.undefines)
    argv.extend(f"-I{dir}" for dir in args.includes)
    argv.extend(["-o", step.output, step.input])
    return argv


def cc1_path() -> str:
    return os.environ.get("CC1") or str(
        Path(__file__).resolve().parent / "target" / "debug" / "cc1"
    )


def compile_argv(step: Step, _: Namespace) -> list[str]:
    return [cc1_path(), step.input, "-o", step.output]


def lower_argv(step: Step, args: Namespace) -> list[str]:
    argv = ["llc", "-relocation-model=pic"]
    if args.optlevel is not None:
        argv.append(f"-O{args.optlevel}")
    argv.extend(["-o", step.output, step.input])
    return argv


def assemble_argv(step: Step, _: Namespace) -> list[str]:
    return ["as", "--32", "-o", step.output, step.input]


def link_argv(args: argparse.Namespace, outputs: dict[str, list[str]]) -> list:
    argv = ["clang", "-m32"]
    if args.strip:
        argv.append("-s")
    for item in args.link_items:
        if item.is_input:
            argv.append(outputs[item.value].pop(0))
        else:
            argv.append(item.value)
    argv.extend(["-o", output_of("", Stage.LINK, args.outfile)])
    return argv


ARGV = {
    Stage.PREPROCESS: preprocess_argv,
    Stage.COMPILE: compile_argv,
    Stage.LOWER: lower_argv,
    Stage.ASSEMBLE: assemble_argv,
}


def tool_argv(step: Step, args: Namespace) -> list:
    return ARGV[step.stage](step, args)


def entry_stage(path: str) -> Stage:
    suffix = Path(path).suffix.lstrip(".")
    if (ret := IN_EXTENTION.get(suffix)) is None:
        raise Exception(f"{path}: invalid file extention")
    return ret


def base_name(path: str) -> str:
    name = Path(path).name
    return name if name else path


def output_of(input: str, last: Stage, requested: "str | None") -> str:
    if requested is not None:
        return requested
    if last == Stage.PREPROCESS:
        return "-"
    if last == Stage.LINK:
        return "a.out"
    return str(Path(base_name(input)).with_suffix("." + OUT_EXTENTION[last]))


def link_items(argv: list[str]) -> list[LinkItem]:
    items = []
    options_with_value = ("-D", "-I", "-O", "-U", "-o")
    it = iter(argv)
    operands_only = False

    for arg in it:
        if operands_only:
            items.append(LinkItem(arg, True))
        elif arg == "--":
            operands_only = True
        elif arg in ("-L", "-l"):
            items.append(LinkItem(arg + next(it), False))
        elif arg.startswith("-L") or arg.startswith("-l"):
            items.append(LinkItem(arg, False))
        elif arg in options_with_value:
            next(it)
        elif arg.startswith(options_with_value) or arg.startswith("-"):
            continue
        else:
            items.append(LinkItem(arg, True))
    return items


def make_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="fcc", description="Forty-two Compiler Collection"
    )
    stop = p.add_mutually_exclusive_group()

    stop.add_argument(
        "-E",
        dest="last",
        action="store_const",
        const=Stage.PREPROCESS,
        help="Stop after preprocessing step.",
    )
    stop.add_argument(
        "-c",
        dest="last",
        action="store_const",
        const=Stage.ASSEMBLE,
        help="Stop after assemble step.",
    )
    stop.add_argument(
        "-e",
        dest="last",
        action="store_const",
        const=Stage.COMPILE,
        help="Stop after llvm generation step.",
    )
    stop.add_argument(
        "-S",
        dest="last",
        action="store_const",
        const=Stage.LOWER,
        help="Stop after lowering step.",
    )

    p.add_argument(
        "-s",
        dest="strip",
        action="store_true",
        help="Strip symbolic and other information not required for proper execution.",
    )
    p.add_argument(
        "-D",
        dest="defines",
        action="append",
        default=[],
        metavar="name[=value]",
        help="Define <macro> to <value> (or 1 if <value> omitted)",
    )
    p.add_argument(
        "-U",
        dest="undefines",
        action="append",
        default=[],
        metavar="name",
        help="Remove any initial definition of <name>.",
    )
    p.add_argument(
        "-I",
        dest="includes",
        action="append",
        default=[],
        metavar="directory",
        help="Add directory to the end of the list of include search paths",
    )
    p.add_argument(
        "-L",
        dest="libs",
        action="append",
        default=[],
        type=lambda dir: f"-L{dir}",
        metavar="directory",
        help="Add <directory> to library search path",
    )
    p.add_argument(
        "-l",
        dest="libs",
        action="append",
        type=lambda lib: f"-l{lib}",
        metavar="library",
        help="Search the library named liblibrary.a or liblibrary.so.",
    )
    p.add_argument(
        "-O",
        dest="optlevel",
        metavar="optlevel",
        help="Specify the level of code optimization.",
    )
    p.add_argument(
        "-o",
        dest="outfile",
        metavar="outfile",
        help="Write output to <file>",
    )
    p.add_argument(
        "files",
        nargs="+",
        metavar="file",
        help="Input file(s): .c .i .ll .s .o .a .so",
    )
    p.set_defaults(last=Stage.LINK)
    return p


