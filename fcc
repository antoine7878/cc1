def check_args(p: ArgumentParser, args: Namespace) -> None:
    for path in args.files:
        if not Path(path).is_file():
            p.error(f"no such file: {path}")

    for path in args.files:
        try:
            entry_stage(path)
        except Exception as e:
            p.error(str(e))

    if (
        args.outfile is not None
        and len(args.files) > 1
        and args.last in (Stage.COMPILE, Stage.LOWER, Stage.ASSEMBLE)
    ):
        p.error("cannot specify -o when generating multiple output files")


def temp_name(input: str, stage: Stage, id: int) -> str:
    stem = Path(base_name(input)).stem or "x"
    return f"{id}-{stem}.{OUT_EXTENTION[stage]}"


def plan(
    input: str, last: Stage, requested: str | None, tmp: str, id: int
) -> list[Step] | None:
    entry = entry_stage(input)
    if entry == Stage.LINK:
        return None
    stop = min(last, Stage.ASSEMBLE)
    steps = []
    current = input

    for stage in PIPELINE:
        if stage < entry or stage > stop:
            continue
        if stage == stop and last != Stage.LINK:
            output = output_of(input, last, requested)
        else:
            output = str(Path(tmp) / temp_name(input, stage, id))
        steps.append(Step(stage, current, output))
        current = output
    return steps


def run(name: str, argv: list) -> None:
    try:
        result = subprocess.run(argv)
    except OSError as e:
        raise Exception(f"{name}: {e.filename}: {e.strerror}")
    if result.returncode != 0:
        raise Exception(f"{name} failed")


def compile(
    args: argparse.Namespace, path: str, tmp: str, id: int
) -> "str | None":
    steps = plan(path, args.last, args.outfile, tmp, id)
    if steps is None:
        return path
    for step in steps:
        argv = tool_argv(step, args)
        run(argv[0], argv)
    if args.last == Stage.LINK and steps:
        return steps[-1].output
    return None


def build(args: Namespace, tmp: str) -> None:
    outputs = {}
    failed = 0
    for id, path in enumerate(args.files):
        try:
            if (obj := compile(args, path, tmp, id)) is not None:
                outputs.setdefault(path, []).append(obj)
        except Exception as e:
            print(f"fcc: {e}", file=sys.stderr)
            failed += 1
    if failed:
        raise Exception(f"{failed} file(s) failed")
    if args.last == Stage.LINK:
        run(TOOL[Stage.LINK], link_argv(args, outputs))


def main(argv: list) -> int:
    parser = make_parser()
    args = parser.parse_intermixed_args(argv)
    args.link_items = link_items(argv)
    check_args(parser, args)
    try:
        with TemporaryDirectory(prefix="fcc") as tmp:
            build(args, tmp)
    except Exception as e:
        print(f"fcc: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
