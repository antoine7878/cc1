/* leading comment before declarations */
%{

#include <stdio.h>
#include <string.h>
#include <stdlib.h>
int yylex();
void yyerror(const char *msg);
extern FILE *yyin;

%}

%union {
    int i;
}
/* comment between declarations */
%start s
%token<i> NUMBER
%%

/* comment in the rules section */
s
    : 'x' /* comment inside a rule */ {printf ("comments ok\n");}
    ;

%%

void yyerror(const char *msg) {
    fprintf(stderr, "%s\n", msg);
}

int main(int argc, char **argv) {
    yyin = fmemopen(argv[1], strlen(argv[1]), "r");
    yyparse();
}
